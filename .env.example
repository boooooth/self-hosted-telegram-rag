# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Comma-separated Telegram numeric user IDs allowed to upload documents.
# Find your own ID by messaging @userinfobot.
ADMIN_USER_IDS=111111111,222222222

# Leave WEBHOOK_URL empty for local dev — the bot auto-discovers the current
# cloudflared quick-tunnel hostname at startup (no Cloudflare account/domain
# needed). Set it explicitly only once deployed somewhere with its own stable
# public URL (Railway/Render/a VPS), or if you set up a named tunnel later.
# Must include the path if set, e.g. https://bot.yourdomain.com/webhook
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
# Arbitrary secret string Telegram echoes back on every webhook call so the
# bot can reject requests that didn't actually come from Telegram. Generate
# your own (don't reuse this placeholder): `python -c "import secrets; print(secrets.token_hex(32))"`
WEBHOOK_SECRET_TOKEN=change-me-to-a-random-string
# Port the bot's internal aiohttp server listens on (cloudflared points at this).
PORT=8080
# Where the bot reads the current quick-tunnel hostname from (cloudflared's
# local metrics endpoint) — only used when WEBHOOK_URL is left empty.
CLOUDFLARED_METRICS_URL=http://cloudflared:20241/quicktunnel

# --- LLM (the only generative step; retrieval/reranking are always local) ---
# litellm model string — provider is inferred from the prefix, e.g.:
#   ollama/llama3.1   (default — no API key needed, runs in the ollama service below)
#   claude-sonnet-5   (needs ANTHROPIC_API_KEY)
#   gpt-4o-mini       (needs OPENAI_API_KEY)
# Switching providers is just changing this one line + the matching key below.
LLM_MODEL=ollama/smollm2:135m
LLM_API_BASE=http://ollama:11434

# Only needed if LLM_MODEL points at a hosted provider instead of ollama/*.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Postgres ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag
DATABASE_URL=postgresql://rag:change-me@postgres:5432/rag

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=chunks

# --- Disk storage (shared volume between bot and worker) ---
UPLOAD_DIR=/data/uploads

# --- Models (downloaded at Docker build time, see Dockerfile) ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval ---
CANDIDATE_POOL_SIZE=25
RERANK_TOP_K=5

# --- Abuse/cost guard ---
COOLDOWN_SECONDS=10
